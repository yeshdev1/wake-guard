<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WakeGuard does not track users and contacts no tracking domains (WG-186). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- No data is collected (transmitted off device) in the default build. Health, motion, location, and
	     calendar are processed on device only; optional cloud AI (off by default) transmits only minimized,
	     redacted data with separate consent — see docs/PRIVACY.md and the WG-187 nutrition-label mapping. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- Required-reason APIs actually used. UserDefaults stores the last-known IANA time zone so alarms
	     stay correct across travel (WG-102). Reason CA92.1: access info stored only for the app itself. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
